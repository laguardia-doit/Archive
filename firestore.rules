rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: collections
    // Fields: title, description, category, imageUrl, isCore, status
    //
    // Collection: exhibits
    // Fields: title, description, category, imageUrl, isFeatured
    //
    // Collection: news
    // Fields: title, description, date
    //
    // Collection: items
    // Fields: title, description, date, collectionId, borough, imageUrl, topics
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "laguardiatraining@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Rules
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exhibits/{exhibitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }
  }
}
